# =============================================================================
# Hearth / FallDetection_S3R8 — Multi-Channel Alert Bot Configuration
# Copy file này thành ".env" trong thư mục alert_bot/ và điền thông tin của bạn
# =============================================================================

# --- 1. Server ---
ALERT_BOT_HOST=0.0.0.0
ALERT_BOT_PORT=8080
# Tùy chọn: đặt mã bảo vệ nếu mở ra Internet (VPS / Cloudflare Tunnel / ngrok)
ALERT_BOT_API_KEY=
ALERT_COOLDOWN_SEC=15
# Tùy chọn: IP LAN của ESP32-S3 để khi bấm "An toàn" trên Telegram sẽ tự tắt còi ESP32
ESP32_LAN_IP=

# --- 2. Telegram Bot API (MIỄN PHÍ — Khuyên dùng bắt buộc) ---
# Tạo bot tại @BotFather -> /newbot -> dán token vào đây
TELEGRAM_BOT_TOKEN=
# Danh sách Chat ID / Group ID mặc định (phân tách bằng dấu phẩy, có thể để trống rồi dùng lệnh /start trên bot)
TELEGRAM_DEFAULT_CHAT_IDS=
TELEGRAM_POLLING_ENABLED=true

# --- 3. CallMeBot — Gọi đổ chuông Telegram MIỄN PHÍ (không cần thẻ tín dụng) ---
# Mỗi người nhận chỉ cần cấp quyền 1 lần tại: https://api2.callmebot.com/txt/login.php (hoặc nhắn /start cho @CallMeBot_txtbot)
CALLMEBOT_ENABLED=true
# Danh sách @username mặc định (ví dụ: @nguyen_an,@tran_binh)
CALLMEBOT_DEFAULT_USERS=
CALLMEBOT_LANG=vi-VN-Standard-A
CALLMEBOT_REPEAT=3

# --- 4. Twilio — Gửi SMS thật & Gọi điện thoại di động đọc tiếng Việt (tùy chọn) ---
# Lấy tại https://console.twilio.com/
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Số điện thoại Twilio (E.164, ví dụ: +15017122661)
TWILIO_FROM_NUMBER=
TWILIO_VOICE_LANG=vi-VN

# --- 5. SpeedSMS Việt Nam — Gửi SMS nội địa VN (tùy chọn) ---
# Lấy Access Token tại https://speedsms.vn/
SPEEDSMS_ACCESS_TOKEN=
SPEEDSMS_SENDER=
SPEEDSMS_TYPE=2

# Mã quốc gia mặc định để tự chuẩn hóa SĐT 09xx -> +849xx
DEFAULT_COUNTRY_CODE=+84

# --- 6. Email OTP khi đăng nhập Hearth App (chọn 1 trong 3 cách) ---
# Cách 1 (Twilio Verify Email): Tạo Verify Service trong Twilio Console + liên kết SendGrid
TWILIO_VERIFY_SERVICE_SID=

# Cách 2 (Twilio SendGrid Mail API — gói Free 100 email/ngày): lấy tại https://app.sendgrid.com/
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=Hearth Fall Guard

# Cách 3 (Gmail / SMTP dự phòng miễn phí): Gmail dùng App Password (16 ký tự)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true

OTP_EXPIRY_SEC=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SEC=30
